{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crustacian.org/schemas/ingest-batch.schema.json",
  "title": "Crustacian Ingest Batch",
  "type": "object",
  "required": [
    "schema_version",
    "batch_id",
    "endpoint_id",
    "sent_at",
    "spool",
    "events"
  ],
  "properties": {
    "schema_version": { "const": "crustacian.ingest.batch.v0" },
    "batch_id": { "type": "string", "minLength": 8 },
    "endpoint_id": { "type": "string", "minLength": 3 },
    "sent_at": { "type": "string" },
    "spool": {
      "type": "object",
      "required": ["queued_events", "disk_bytes", "dropped_low_priority_events"],
      "properties": {
        "queued_events": { "type": "integer", "minimum": 0 },
        "disk_bytes": { "type": "integer", "minimum": 0 },
        "dropped_low_priority_events": { "type": "integer", "minimum": 0 }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "endpoint-event.schema.json" }
    }
  }
}
