{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crustacian.org/schemas/ingest-batch.schema.json",
  "title": "Crustacian Ingest Batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "endpoint_id",
    "sent_at",
    "events"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "batch_id": {
      "type": "string",
      "minLength": 12
    },
    "endpoint_id": {
      "type": "string",
      "minLength": 6
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "spool": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "oldest_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "newest_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "queued_events": {
          "type": "integer",
          "minimum": 0
        },
        "disk_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "dropped_low_priority_events": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "endpoint-event.schema.json"
      }
    }
  }
}
